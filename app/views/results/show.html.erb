<h1>
  <%= @result.date.year %> - <%= @result.race.to_s %>
</h1>

<article>
  <%= render @result %>
</article>

<% if @next && @next != @fastest %>
  <article>
    <details style="margin-bottom: 0">
      <summary>
        <span style="font-size: 1.75rem; font-weight: 700">
          Next (<%= @next.date.year %>)
        </span>
      </summary>
      <%= render @next %>
    </details>
  </article>
<% end %>

<% if @previous && @previous != @fastest %>
  <article>
    <details style="margin-bottom: 0">
      <summary>
        <span style="font-size: 1.75rem; font-weight: 700">
          Previous (<%= @previous.date.year %>)
        </span>
      </summary>
      <%= render @previous %>
    </details>
  </article>
<% end %>

<% if @fastest %>
  <article>
    <details style="margin-bottom: 0">
      <summary>
        <span style="font-size: 1.75rem; font-weight: 700">
          Fastest (<%= @fastest.date.year %>)
        </span>
      </summary>
      <%= render @fastest %>
    </details>
  </article>
<% end %>

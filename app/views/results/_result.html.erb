<div id="<%= dom_id result %>">
  <p>
    <strong>Duration:</strong>
    <%= result.duration_s %>
  </p>

  <% if result.position.present? %>
    <p>
      <strong>Position:</strong>
      <%= result.position %>
    </p>
  <% end %>

  <% if result.finishers.present? %>
    <p>
      <strong>Finishers:</strong>
      <%= result.finishers %>
    </p>
  <% end %>

  <% if result.comment.present? %>
    <p>
      <strong>Comment:</strong>
      <%= result.comment %>
    </p>
  <% end %>

  <% if result.url.present? %>
    <p>
      <%= link_to 'More details ...', result.url %>
    </p>
  <% end %>

  <% if result.wind.present? %>
    <p>
      <strong>Wind:</strong>
      <%= result.wind %>
    </p>
  <% end %>

  <% if result.fastest_duration.present? %>
    <p>
      <strong>Fastest duration:</strong>
      <%= result.fastest_duration %>
    </p>
  <% end %>

  <% if result.median_duration.present? %>
    <p>
      <strong>Median duration:</strong>
      <%= result.median_duration %>
    </p>
  <% end %>

</div>

<h2 class="pico-color-red-200">pico-color-red-200 Title</h2>

<%= form_with(model: result) do |form| %>

  <div>
    <%= form.label :user_id %>
    <%= form.collection_select :user_id, User.all, :id, :email_address, prompt: "Select ..." %>
  </div>

  <div>
    <%= form.label :race_id %>
    <%= form.collection_select :race_id, Race.all, :id, :name, prompt: "Select ..." %>
  </div>

  <div>
    <%= form.label :duration %>
    <%= form.number_field :duration %>
  </div>

  <div>
    <%= form.label :date %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :comment %>
    <%= form.textarea :comment %>
  </div>

  <div>
    <%= form.label :url %>
    <%= form.text_field :url %>
  </div>

  <div>
    <%= form.label :wind %>
    <%= form.text_field :wind %>
  </div>

  <div>
    <%= form.label :fastest_duration %>
    <%= form.number_field :fastest_duration %>
  </div>

  <div>
    <%= form.label :median_duration %>
    <%= form.number_field :median_duration %>
  </div>

  <div>
    <%= form.label :position %>
    <%= form.number_field :position %>
  </div>

  <div>
    <%= form.label :finishers %>
    <%= form.number_field :finishers %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

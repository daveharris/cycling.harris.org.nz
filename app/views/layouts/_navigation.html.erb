<nav>
  <ul>
    <li><h2><%= link_to 'Cycling', root_path %></h2></li>
    <% if authenticated? %>
      <li><%= link_to 'Races', races_path %></li>
    <% end %>
    <% if authenticated? %>
      <li><%= link_to 'Results', results_path %></li>
    <% end %>
  </ul>
  <ul>
    <% if authenticated? %>
      <li><%= button_to 'Sign out', session_path, method: :delete, class: "outline" %></li>
    <% else %>
      <li><%= link_to 'Sign in', new_session_path, role: "button", class: "outline" %></li>
    <% end %>
  </ul>
</nav>

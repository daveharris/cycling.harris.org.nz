<div class="grid">
  <div>
    <h1>Races</h1>
  </div>
  <div>
    <%= link_to 'Add', new_race_path, role: "button", class: "secondary" %>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Distance</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @races.each do |race| %>
      <tr>
        <td><%= link_to race.name, race_path(race) %></td>
        <td><%= race.distance %> km</td>
        <td class="grid">
          <%= button_to 'Edit', edit_race_path(race), class: "secondary", method: :get %>
          <%= button_to 'Delete', race, class: "contrast", method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
